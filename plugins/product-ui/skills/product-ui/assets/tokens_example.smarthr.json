{
  "meta": {
    "name": "Preset using smarthr-ui token values",
    "surface": "saas",
    "reference": "smarthr",
    "stack": {
      "renderer": "vite-react",
      "tailwind": "4",
      "base": "smarthr-ui"
    },
    "defaults_applied": [
      "color_dark omitted — SmartHR publishes no dark theme",
      "motion left at the product-ui default — SmartHR publishes no motion tokens",
      "T5 warning accepted — system-ui is the font family smarthr-ui ships",
      "T10 warning accepted — SmartHR LAYER1/2/3 all use alpha 0.3, and only the offset and blur differ"
    ]
  },
  "color": {
    "background": "oklch(97.7% 0.002 68)",
    "foreground": "oklch(25.2% 0.008 95)",
    "surface": "oklch(100% 0 0)",
    "primary": "oklch(55.7% 0.152 248)",
    "primary_foreground": "oklch(100% 0 0)",
    "muted": "oklch(94.1% 0.005 78)",
    "muted_foreground": "oklch(53.5% 0.013 90)",
    "border": "oklch(86.8% 0.005 68)",
    "destructive": "oklch(58.8% 0.222 11)",
    "accent": "oklch(74.6% 0.127 200)"
  },
  "typography": {
    "display": {
      "family": "system-ui",
      "source": "OS",
      "weights": [400, 700]
    },
    "body": {
      "family": "system-ui",
      "source": "OS",
      "weights": [400, 700]
    },
    "scale": {
      "ratio": 1.2,
      "base_px": 16
    }
  },
  "spacing": {
    "base_px": 4,
    "steps": [1, 2, 3, 4, 5, 6, 8, 10, 12, 14, 16, 32]
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px 0 oklch(9.6% 0.005 107 / 0.3)",
    "md": "0 2px 4px 1px oklch(9.6% 0.005 107 / 0.3)",
    "lg": "0 4px 8px 2px oklch(9.6% 0.005 107 / 0.3)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "spring": "linear(0, 0.36, 0.82, 1.02, 1)"
    }
  },
  "voice": {
    "lang": "ja",
    "register": "敬体",
    "button_form": "終止形。サ変は「する」を省く",
    "katakana_choon": "jtf",
    "case": null,
    "terms": {
      "サインイン": "ログイン",
      "消去": "削除"
    },
    "allow": []
  }
