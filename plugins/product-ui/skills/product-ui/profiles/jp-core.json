  "evidence": [
    {
      "id": "yayoi-kaikei-env",
      "source": "弥生会計 サポート情報, 弥生会計の環境設定",
      "url": "https://support.yayoi-kk.co.jp/subcontents.html?page_id=18326",
      "says": "In books and slips, Enter moves to the next item and Shift+Enter to the previous one."
    },
    {
      "id": "yayoi-hanbai-keys",
      "source": "弥生販売 サポート情報, 弥生販売のショートカットキー一覧",
      "url": "https://support.yayoi-kk.co.jp/subcontents.html?page_id=22523",
      "says": "F12 登録 registers a slip or a ledger record, F9 削除 deletes it, F2 新規作成 clears the screen for a new one, F8 参照 opens the lookup of the field under the cursor, Ctrl+F 検索 opens the search, Ctrl+Insert and Ctrl+Delete insert and delete a line, and Tab, the arrow keys and Enter move to the next item."
    },
    {
      "id": "yayoi-hanbai-closing",
      "source": "弥生販売 サポート情報, 請求締切の操作手順",
      "url": "https://support.yayoi-kk.co.jp/faq_Subcontents.html?page_id=20329",
      "says": "Before the closing runs, a message states what it covers and ends with よろしいですか."
    },
    {
      "id": "bugyo-j-register",
      "source": "OBC 奉行Jシリーズ 早わかり操作集, 部門を登録する",
      "url": "https://www.obc.co.jp/bugyo-j/jseries/quick/quick-op/04",
      "says": "The [登録](F12) button registers the entry, after a message that begins 登録します。よろしいですか."
    },
    {
      "id": "bugyo-j-recall",
      "source": "OBC 奉行Jシリーズ 早わかり操作集, 定型取引を呼び出して使用する",
      "url": "https://www.obc.co.jp/bugyo-j/jseries/quick/quick-op/16",
      "says": "Enter after the last item of a line registers the line, and the [定型呼出](F6) button recalls a registered transaction."
    },
    {
      "id": "bugyo-j-edit",
      "source": "OBC 奉行Jシリーズ 早わかり操作集, 帳簿入力後の検索・確認・修正をしたい",
      "url": "https://www.obc.co.jp/bugyo-j/jseries/quick/quick-op/13",
      "says": "The [修正](F9) button opens the chosen journal entry for editing."
    },
    {
      "id": "bugyo-j-buttons",
      "source": "OBC 勘定奉行J11, 機能",
      "url": "https://www.obc.co.jp/bugyo-j/kanjo-j/feature/01",
      "says": "The buttons on the screen correspond to the function keys F1 to F12."
    },
    {
      "id": "pca-keys",
      "source": "PCA 会計シリーズ マニュアル, ボタン、メニューバー、キーなどの操作",
      "url": "https://pca.jp/area_support/manual/acc/a_Common/Button_menu_key.html",
      "says": "The shortcuts on function keys are shown together at the foot of the screen, and each can be pressed or clicked."
    },
    {
      "id": "terasoluna-double-submit",
      "source": "TERASOLUNA Server Framework for Java (5.x) Development Guideline, 二重送信防止",
      "url": "https://terasolunaorg.github.io/guideline/current/ja/ArchitectureInDetail/WebApplicationDetail/DoubleSubmitProtection.html",
      "says": "After a button is clicked it cannot be clicked again until the screen is redrawn."
    }
